# Copy to .env and change the passwords/secret before deploying anywhere public.
POSTGRES_USER=kalcer
POSTGRES_PASSWORD=kalcer_password
POSTGRES_DB=kalcerplanner
DB_PORT=5432
APP_PORT=3000

# Used by `npm run dev` / Prisma CLI on your machine (host = localhost).
# Inside Docker, docker-compose.yml builds its own DATABASE_URL pointing at the `db` service.
DATABASE_URL="postgresql://kalcer:kalcer_password@localhost:5432/kalcerplanner?schema=public"

# Signs the login session cookie. REQUIRED. Generate a random one, e.g.:
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   macOS/Linux: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Optional curator (ADMIN) account, created by the seed. Lets you verify data submitted by cultural
# practitioners at /pelaku. Use a strong password (min. 8 chars), then remove it from .env if you like.
ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
