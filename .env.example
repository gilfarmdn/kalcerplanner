# Copy to .env and change the passwords/secret before deploying anywhere public.
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=YOUR_DATABASE
DB_PORT=YOUR_PORT_DB
APP_PORT=YOUR_APP_PORT

# Used by `npm run dev` / Prisma CLI on your machine (host = localhost).
# Inside Docker, docker-compose.yml builds its own DATABASE_URL pointing at the `db` service.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:YOUR_PORT_DB/YOUR_DATABASE?schema=public"

# Signs the login session cookie. REQUIRED. Generate a random one, e.g.:
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   macOS/Linux: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Optional curator (ADMIN) account, created by the seed. Lets you verify data submitted by cultural
# practitioners at /pelaku. Use a strong password (min. 8 chars), then remove it from .env if you like.
ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_PUBLIC_SITE_URL=YOUR_URL_SITE

# Email (SMTP). Without SMTP_HOST, emails are printed to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KalcerPlanner <no-reply@example.com>"

# Cloudflare Turnstile (bot check on sign-up and forgot-password). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile and add your site's hostname.
# Leave empty to skip the check (local development only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
